# AUTO-GENERATED by ansible (roles/app) - DO NOT EDIT BY HAND.
# Injects Terraform outputs, image tags and vault secrets into the umbrella chart.
global:
  image:
    registry: {{ image_registry }}
    repository: {{ image_repository }}
    pullPolicy: {{ image_pull_policy }}
  serviceAccount:
    name: {{ service_account_name }}
    roleArn: {{ irsa_role_arn }}
  database:
    host: {{ db_host }}
    port: "{{ db_port }}"
    name: {{ db_name }}
    user: {{ db_user }}
  aws:
    region: {{ aws_region_out | default(aws_region) }}
    s3BucketName: {{ s3_bucket_name }}
    snsTopicArn: {{ sns_topic_arn }}

common:
  secret:
    secretKey: {{ vault_app_secret_key | quote }}

auth:
  replicaCount: {{ applications.auth.replicas }}
  image:
    tag: {{ applications.auth.image_tag }}

backend:
  replicaCount: {{ applications.backend.replicas }}
  image:
    tag: {{ applications.backend.image_tag }}

frontend:
  replicaCount: {{ applications.frontend.replicas }}
  image:
    tag: {{ applications.frontend.image_tag }}

database:
  storageClass:
    fileSystemId: {{ efs_filesystem_id }}
  credentials:
    password: {{ vault_db_password | quote }}

aws_region         = "us-east-1"
project_name       = "main-app"
environment        = "prod"
cluster_name       = "main-app-eks-arm"
kubernetes_version = "1.30"

vpc_cidr            = "10.60.0.0/16"
public_subnet_cidr  = "10.60.1.0/24"
private_subnet_cidr = "10.60.2.0/24"

node_instance_type = "t4g.small"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 2

service_account_namespace = "main-app"
service_account_name      = "app-irsa-sa"

# SNS alert recipients - add one or more emails; each must confirm the
# subscription link AWS sends before it starts receiving alerts.
sns_subscription_emails = [
  "gta.afek@gmail.com",
]

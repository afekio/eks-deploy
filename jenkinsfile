pipeline {
    agent {
        docker {
            image 'jenkins-docker:latest'
            // מיפוי ה-Socket כדי שה-Agent יוכל להריץ פקודות Docker
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    // הגדרת משתנים שניתן להזין בעת הרצת ה-Job
    parameters {
        string(name: 'GITHUB_REPO_URL', defaultValue: 'https://github.com/afekio/eks-deploy.git', description: 'URL of the GitHub Repository to clone')
        string(name: 'DOCKERHUB_REPO', defaultValue: 'afekio', description: 'Docker Hub Username or Registry URL (e.g., afekio or my-registry.com/afekio)')
        string(name: 'IMAGE_NAME', defaultValue: 'my-app', description: 'Base name for the docker images')
        string(name: 'IMAGE_TAG', defaultValue: '2.0', description: 'Tag/Version for the images')
        string(name: 'ALERT_EMAIL', defaultValue: 'admin@example.com', description: 'Email for notifications')
    }

    environment {
        // Credential ID מג'נקינס בשביל ההתחברות ל-Docker Hub
        DOCKER_CREDS = 'docker-hub-credentials'
        SERVICES = 'Backend Frontend Auth'
    }

    stages {
        stage('Checkout Code') {
            steps {
                script {
                    echo "Cloning repository from: ${params.GITHUB_REPO_URL}"
                }
                // משיכת הקוד מהכתובת שהוזנה בפרמטר
                git branch: 'main', url: "${params.GITHUB_REPO_URL}"
            }
        }

        stage('Security Scan (SonarQube)') {
            steps {
                script {
                    echo "Running Security Scan..."
                    // withSonarQubeEnv('SonarQube') { sh 'sonar-scanner' }
                }
            }
        }

        stage('Python Linting') {
            steps {
                script {
                    def folders = env.SERVICES.split(' ')
                    for (folder in folders) {
                        dir(folder) {
                            echo "Running Linting on ${folder}..."
                            sh 'pip install flake8 || true'
                            sh 'flake8 . --count --exit-zero --max-complexity=10 --max-line-length=127'
                        }
                    }
                }
            }
        }

        stage('Unit Tests') {
            steps {
                script {
                    def folders = env.SERVICES.split(' ')
                    for (folder in folders) {
                        dir(folder) {
                            echo "Running Tests on ${folder}..."
                            sh 'pip install pytest || true'
                            sh 'pytest || echo "No tests failed, continuing..."'
                        }
                    }
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                script {
                    def folders = env.SERVICES.split(' ')
                    for (folder in folders) {
                        dir(folder) {
                            // שימוש במשתנה ה-Docker Hub שהוזן בפרמטר
                            def fullImageName = "${params.DOCKERHUB_REPO}/${params.IMAGE_NAME}:${folder}-${params.IMAGE_TAG}"
                            echo "Building image: ${fullImageName}"
                            sh "docker build -t ${fullImageName} ."
                        }
                    }
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: env.DOCKER_CREDS, passwordVariable: 'PASS', usernameVariable: 'USER')]) {
                        sh 'echo $PASS | docker login -u $USER --password-stdin'
                        
                        def folders = env.SERVICES.split(' ')
                        for (folder in folders) {
                            def fullImageName = "${params.DOCKERHUB_REPO}/${params.IMAGE_NAME}:${folder}-${params.IMAGE_TAG}"
                            echo "Pushing image: ${fullImageName}"
                            sh "docker push ${fullImageName}"
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            mail to: "${params.ALERT_EMAIL}",
                 subject: "SUCCESS: Jenkins Pipeline ${env.JOB_NAME}",
                 body: "Pipeline completed successfully.\nImages pushed to ${params.DOCKERHUB_REPO} with tag ${params.IMAGE_TAG}.\nCheck logs at: ${env.BUILD_URL}"
        }
        failure {
            mail to: "${params.ALERT_EMAIL}",
                 subject: "FAILED: Jenkins Pipeline ${env.JOB_NAME}",
                 body: "Pipeline Failed!\nCheck logs at: ${env.BUILD_URL}"
        }
    }
}